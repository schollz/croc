{
  "name": "croc-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run wasm && vite",
    "serve": "go run ../cmd/croc-web localhost:5173",
    "serve:backend": "go run ../cmd/croc-web --bind 127.0.0.1:9014 localhost:5173",
    "dev:hot": "npm run embed && concurrently --kill-others --success first --names web,server 'npm:dev' 'npm:serve:backend'",
    "dev:stack": "npm run embed && npm run serve",
    "wasm": "node scripts/build-wasm.mjs",
    "embed": "npm run build && node scripts/embed-dist.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "npm run embed && playwright test",
    "test:all": "npm test && npm run test:e2e",
    "build": "npm run wasm && tsc -b && vite build && node scripts/generate-blog-pages.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "arrival-time": "^1.0.6",
    "lossless-json": "4.3.4",
    "lucide-react": "^1.82.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "ws": "^8.23.0"
  }
}
